# Contrato de configuración de Ritmo Claro API.
# Copia este archivo como .env y reemplaza los valores ficticios.
# .env nunca se sube al repositorio ni entra en la imagen Docker.

# Cadena de conexión a PostgreSQL que usan la app y Prisma (migraciones).
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=public
# - Local: HOST=localhost y BASE=ritmo_claro.
# - Docker contra un PostgreSQL instalado en tu computador: HOST=host.docker.internal
#   (pásalo con -e al ejecutar el contenedor; ver README).
# - Producción (Supabase): usa la cadena del Session Pooler.
DATABASE_URL="postgresql://USUARIO_DB:CLAVE_DB@localhost:5432/ritmo_claro?schema=public"

# Secreto con el que se firman y verifican los JWT (HS256).
# Usa una cadena larga y aleatoria, distinta en cada entorno; si cambia,
# todos los tokens emitidos dejan de ser válidos. La app no arranca si falta.
JWT_SECRET="reemplaza-por-un-secreto-largo-y-aleatorio"

# Puerto HTTP en el que escucha la API (3000 si no se define).
# En Render no se configura: la plataforma lo inyecta.
PORT=3000
