# Copia este archivo como .env y reemplaza los valores ficticios.
# Nunca subas .env al repositorio.

# Cadena de conexión a PostgreSQL (local: base ritmo_claro)
DATABASE_URL="postgresql://USUARIO_DB:CLAVE_DB@localhost:5432/ritmo_claro?schema=public"

# Secreto para firmar los JWT: usa una cadena larga y aleatoria
JWT_SECRET="reemplaza-por-un-secreto-largo-y-aleatorio"

# Puerto HTTP de la API (3000 por defecto)
PORT=3000
